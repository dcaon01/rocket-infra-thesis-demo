{{#if productLogoUrl}}<img src="{{productLogoUrl}}" height="32" alt="{{productName}}" style="display:block;height:32px;width:auto;max-width:180px;border:0;margin:0 0 20px 0;">{{/if}}
<h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;font-weight:600;color:#0A0A0A;">Pagamento da attivare</h1>
<p style="margin:0 0 12px 0;">Il pagamento del contratto <strong style="font-weight:600;">{{contractCode}}</strong> di {{companyName}} su {{productName}} non è ancora attivo. Il referente lo attiva al primo accesso a {{productName}}, oppure da qui: basta dare il mandato SEPA sul conto dell'azienda.</p>
{{#if suspensionDate}}<p style="margin:0 0 0 0;">Se il pagamento non viene attivato, gli accessi saranno sospesi dal <strong style="font-weight:600;">{{suspensionDate}}</strong>.</p>{{/if}}
{{#if checkoutUrl}}<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 0 0;">
<tr>
<td class="rk-btn" ${button_cell}>
<a href="{{checkoutUrl}}" style="display:inline-block;padding:10px 20px;font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;">Attiva il pagamento</a>
</td>
</tr>
</table>{{/if}}
