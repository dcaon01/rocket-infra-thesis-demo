<!DOCTYPE html>
<!-- Brand frame shared by every Rocket email, signed by Keus: the recipients know Keus, not the platform. Colours and type mirror the Keus mode of the rocket-fe theme (src/styles.css). -->
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Keus</title>
<link href="https://fonts.googleapis.com/css2?family=Zalando+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
/* Phones: smaller type and tighter frame. Gmail reads these rules for Google accounts; elsewhere the desktop sizes stay. */
@media only screen and (max-width:600px) {
  .rk-frame { padding:20px 10px !important; }
  .rk-card { padding:22px 18px !important; font-size:14px !important; line-height:1.55 !important; }
  .rk-card h1 { font-size:19px !important; }
  .rk-btn a { padding:10px 18px !important; font-size:14px !important; }
}
</style>
</head>
<body style="margin:0;padding:0;background-color:#FCFBF7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FCFBF7" style="background-color:#FCFBF7;">
<tr>
<td class="rk-frame" align="center" style="padding:32px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
<tr>
<td style="padding:0 4px 20px 4px;">
<img src="${asset_base_url}/keus-logo-dark.png" width="92" height="22" alt="Keus" style="display:block;border:0;">
</td>
</tr>
<tr>
<td class="rk-card" bgcolor="#FFFFFF" style="background-color:#FFFFFF;border:1px solid #DCD4C8;border-radius:10px;padding:32px;font-family:'Zalando Sans',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#0A0A0A;">
${content}
</td>
</tr>
<tr>
<td style="padding:24px 4px 0 4px;font-family:'Zalando Sans',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#817B78;">
<p style="margin:0;">Messaggio automatico di Keus: le risposte a questo indirizzo non vengono lette.</p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
