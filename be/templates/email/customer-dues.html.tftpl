<h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;font-weight:600;color:#0A0A0A;">Scadenze dei vostri clienti</h1>
<p style="margin:0 0 0 0;">Queste sono le scadenze dei clienti di {{resellerName}} ancora da incassare. Gli importi sono IVA esclusa; quando avete incassato, segnatelo nello scadenziario e l'avviso non torna.</p>
{{#if dueToday.length}}
<h2 style="margin:24px 0 12px 0;font-size:16px;line-height:1.3;font-weight:600;color:#0A0A0A;">In scadenza oggi</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E7E1D8;border-radius:10px;border-collapse:separate;">
<tr>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;border-top-left-radius:10px;">Cliente</td>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;">Voce</td>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;text-align:right;border-top-right-radius:10px;">Importo</td>
</tr>
{{#each dueToday}}
<tr>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;">{{companyName}}</td>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;">{{description}}<br><span style="font-size:12px;color:#817B78;">scadenza {{dueDate}}</span></td>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;text-align:right;white-space:nowrap;">{{amount}}</td>
</tr>
{{/each}}
</table>
{{/if}}
{{#if late.length}}
<h2 style="margin:24px 0 12px 0;font-size:16px;line-height:1.3;font-weight:600;color:#0A0A0A;">Scadute da 5 giorni</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E7E1D8;border-radius:10px;border-collapse:separate;">
<tr>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;border-top-left-radius:10px;">Cliente</td>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;">Voce</td>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;text-align:right;border-top-right-radius:10px;">Importo</td>
</tr>
{{#each late}}
<tr>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;">{{companyName}}</td>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;">{{description}}<br><span style="font-size:12px;color:#817B78;">scadenza {{dueDate}}</span></td>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;text-align:right;white-space:nowrap;">{{amount}}</td>
</tr>
{{/each}}
</table>
{{/if}}
{{#if veryLate.length}}
<h2 style="margin:24px 0 12px 0;font-size:16px;line-height:1.3;font-weight:600;color:#0A0A0A;">Scadute da 10 giorni</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E7E1D8;border-radius:10px;border-collapse:separate;">
<tr>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;border-top-left-radius:10px;">Cliente</td>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;">Voce</td>
<td bgcolor="#FAF7F2" style="background-color:#FAF7F2;padding:10px 16px;font-size:12px;font-weight:600;color:#817B78;border-bottom:1px solid #E7E1D8;text-align:right;border-top-right-radius:10px;">Importo</td>
</tr>
{{#each veryLate}}
<tr>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;">{{companyName}}</td>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;">{{description}}<br><span style="font-size:12px;color:#817B78;">scadenza {{dueDate}}</span></td>
<td valign="top" style="padding:12px 16px;font-size:14px;color:#0A0A0A;text-align:right;white-space:nowrap;">{{amount}}</td>
</tr>
{{/each}}
</table>
{{/if}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 0 0;">
<tr>
<td class="rk-btn" ${button_cell}>
<a href="{{scheduleUrl}}" style="display:inline-block;padding:10px 20px;font-size:14px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;">Apri lo scadenziario</a>
</td>
</tr>
</table>
