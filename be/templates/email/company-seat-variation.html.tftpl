{{#if productLogoUrl}}<img src="{{productLogoUrl}}" height="32" alt="{{productName}}" style="display:block;height:32px;width:auto;max-width:180px;border:0;margin:0 0 20px 0;">{{/if}}
<h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;font-weight:600;color:#0A0A0A;">Variazione delle postazioni</h1>
<p style="margin:0 0 12px 0;">Le postazioni di {{companyName}} su {{productName}}, contratto <strong style="font-weight:600;">{{contractCode}}</strong>, passano da {{seatsFrom}} a <strong style="font-weight:600;">{{seatsTo}}</strong>.</p>
<p style="margin:0 0 12px 0;">Fino al {{periodEnd}} si aggiunge un rateo di <strong style="font-weight:600;">{{proratedAmount}}</strong> più IVA, addebitato sul mandato SEPA.</p>
{{#if renewalDate}}<p style="margin:0 0 0 0;">Dal rinnovo del {{renewalDate}} il canone del contratto sarà di {{renewalAmount}} più IVA.</p>{{/if}}
