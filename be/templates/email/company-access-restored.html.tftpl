{{#if productLogoUrl}}<img src="{{productLogoUrl}}" height="32" alt="{{productName}}" style="display:block;height:32px;width:auto;max-width:180px;border:0;margin:0 0 20px 0;">{{/if}}
<h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;font-weight:600;color:#0A0A0A;">Accessi riattivati</h1>
<p style="margin:0 0 0 0;">Gli accessi di {{companyName}} a {{productName}}, contratto <strong style="font-weight:600;">{{contractCode}}</strong>, sono di nuovo attivi.</p>
